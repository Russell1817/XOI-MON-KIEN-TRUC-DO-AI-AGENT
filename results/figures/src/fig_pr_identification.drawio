<mxfile host="drawio" version="32.4.1">
  <diagram id="pr_id" name="Xác định PR từ lịch sử git">
    <mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lbl_main" value="&lt;b&gt;Nhánh chính&lt;/b&gt;&lt;br&gt;(first-parent)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="10" y="150" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lbl_branch" value="Nhánh PR #12" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=2;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="10" y="60" width="110" height="30" as="geometry" />
        </mxCell>

        <!-- main line commits -->
        <mxCell id="c1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#0B0B0B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="155" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#0B0B0B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="155" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2A78D6;strokeColor=#0B0B0B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="480" y="155" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2A78D6;strokeColor=#0B0B0B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="155" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#0B0B0B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="155" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- branch commits -->
        <mxCell id="b1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F2F2F0;strokeColor=#52514E;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="60" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F2F2F0;strokeColor=#52514E;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="60" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- main line edges (child -> parent drawn left to right as history) -->
        <mxCell id="e1" style="html=1;endArrow=none;strokeWidth=3;strokeColor=#0B0B0B;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="html=1;endArrow=none;strokeWidth=3;strokeColor=#0B0B0B;" edge="1" parent="1" source="c2" target="m1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="html=1;endArrow=none;strokeWidth=3;strokeColor=#0B0B0B;" edge="1" parent="1" source="m1" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="html=1;endArrow=none;strokeWidth=3;strokeColor=#0B0B0B;" edge="1" parent="1" source="s1" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb0" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#52514E;dashed=1;" edge="1" parent="1" source="c2" target="b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb1" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#52514E;dashed=1;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb2" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#52514E;dashed=1;" edge="1" parent="1" source="b2" target="m1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- annotations -->
        <mxCell id="a_before" value="&lt;b&gt;trước&lt;/b&gt; = M^1" style="text;html=1;align=center;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="220" y="190" width="110" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a_merge" value="&lt;b&gt;M&lt;/b&gt; = &quot;Merge pull request #12&quot;&lt;br&gt;(kiểu merge, 2 cha)&lt;br&gt;&lt;b&gt;sau&lt;/b&gt; = M" style="text;html=1;align=center;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="395" y="190" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_squash" value="&lt;b&gt;S&lt;/b&gt; = &quot;Sửa lỗi đăng nhập (#15)&quot;&lt;br&gt;(kiểu squash, 1 cha)&lt;br&gt;trước = S^1, sau = S" style="text;html=1;align=center;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="615" y="190" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_c5" value="commit không&lt;br&gt;đóng PR: bỏ qua" style="text;html=1;align=center;verticalAlign=top;fontFamily=Arial;fontSize=12;fontStyle=2;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="840" y="190" width="110" height="40" as="geometry" />
        </mxCell>

        <!-- classification box -->
        <mxCell id="cls" value="&lt;b&gt;Phân nhóm theo số PR:&lt;/b&gt; số có trong AIDev → &lt;b&gt;agent&lt;/b&gt;; số khác, trong ±6 tháng, không phải bot, không có dấu vết agent → &lt;b&gt;người&lt;/b&gt;.&lt;br&gt;Thay đổi của PR = diff(M^1, M): như nhau cho kiểu merge và squash." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#52514E;dashed=1;fontFamily=Arial;fontSize=13;fontColor=#3A3A38;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="275" width="790" height="58" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="● commit đóng PR (được phân tích)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#2A78D6;" vertex="1" parent="1">
          <mxGeometry x="640" y="60" width="290" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
