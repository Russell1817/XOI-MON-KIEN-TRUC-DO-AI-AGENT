<mxfile host="drawio" version="32.4.1">
  <diagram id="example" name="Hình 2 – Ví dụ chỉ số">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Panel titles -->
        <mxCell id="t1" value="&lt;b&gt;(a) Trước PR (commit M^1)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;(b) Sau PR (commit M)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="540" y="10" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sep" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#9A9994;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="20" as="sourcePoint" />
            <mxPoint x="490" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Layer labels -->
        <mxCell id="L1" value="Tầng giao diện" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=2;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="Tầng nghiệp vụ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=2;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="20" y="160" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="Tầng dữ liệu" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=2;fontColor=#52514E;" vertex="1" parent="1">
          <mxGeometry x="20" y="260" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- Before -->
        <mxCell id="a_api" value="app.api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2A78D6;strokeWidth=2;fontFamily=Courier New;fontSize=17;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="230" y="60" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a_svc" value="app.services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2A78D6;strokeWidth=2;fontFamily=Courier New;fontSize=17;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="230" y="160" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a_mod" value="app.models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2A78D6;strokeWidth=2;fontFamily=Courier New;fontSize=17;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="230" y="260" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ae1" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0B0B0B;" edge="1" parent="1" source="a_api" target="a_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0B0B0B;" edge="1" parent="1" source="a_svc" target="a_mod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- After -->
        <mxCell id="b_api" value="app.api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F0;strokeColor=#52514E;strokeWidth=2;fontFamily=Courier New;fontSize=17;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="640" y="60" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_svc" value="app.services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F0;strokeColor=#52514E;strokeWidth=2;fontFamily=Courier New;fontSize=17;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="640" y="160" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_mod" value="app.models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F0;strokeColor=#52514E;strokeWidth=2;fontFamily=Courier New;fontSize=17;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="640" y="260" width="140" height="40" as="geometry" />
