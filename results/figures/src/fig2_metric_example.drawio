        <!-- Captions of the measured effect -->
        <mxCell id="c1" value="Không có chu trình giữa các package&lt;br&gt;Mọi cạnh đi từ tầng trên xuống tầng dưới" style="text;html=1;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#3A3A38;" vertex="1" parent="1">
          <mxGeometry x="90" y="320" width="420" height="60" as="geometry" />
