        <mxCell id="be2" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0B0B0B;" edge="1" parent="1" source="b_svc" target="b_mod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be3" value="cạnh mới&lt;br&gt;(do PR thêm)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#C0392B;dashed=1;dashPattern=8 4;fontFamily=Arial;fontSize=16;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_mod" target="b_api">
