        <mxCell id="c2" value="Cạnh package mới = 1&lt;br&gt;C_new = 1: 3 package vào cùng một SCC&lt;br&gt;Vi phạm phân tầng = 1 (dữ liệu → giao diện)" style="text;html=1;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#3A3A38;" vertex="1" parent="1">
